# ==========================================================
# GitHub Linguist — repo ini ditampilkan sebagai PHP (CodeIgniter)
# ==========================================================
# Diagram bahasa: PHP dominan,|TypeScript dan SCSS sebagai
# pelengkap. JavaScript, CSS, dan Shell sengaja dikeluarkan dari
# statistik. HTML 0% — file .html dipaksa dibaca sebagai PHP karena
# ia view template yang dilayani CodeIgniter, bukan halaman statis.
#
# Atribut di bawah hanya memengaruhi tampilan Linguist di GitHub.
# Tidak mengubah file, tidak memengaruhi `npm run build`,
# `php -S`, maupun runtime CodeIgniter.

# ---------- 1. Dependency & aset pihak ketiga (vendored) ----------
# 940 file node_modules ikut ter-commit; tanpa ini ribuan baris
# JavaScript memenuhi diagram.
**/node_modules/**    linguist-vendored
**/vendor/**          linguist-vendored
package-lock.json     linguist-vendored
skills-lock.json      linguist-vendored
backend/uploads/**    linguist-vendored

# ---------- 2. Build output (generated) ----------
admin-ci/main-*.js        linguist-generated
admin-ci/main-*.css       linguist-generated
admin-ci/styles-*.css     linguist-generated
*.min.js                  linguist-generated
*.min.css                 linguist-generated
*.min.map                 linguist-generated
dist/**                   linguist-generated
build/**                  linguist-generated
www/**                    linguist-generated

# ---------- 3. Cache / laporan tool ----------
graphify-out/**           linguist-vendored

# ---------- 4. Dokumentasi ----------
*.md                   linguist-documentation
LICENSE*               linguist-documentation

# ---------- 5. Config, data, aset non-bahasa ----------
*.json                 linguist-vendored
*.toml                 linguist-vendored
*.yml                  linguist-vendored
*.yaml                 linguist-vendored
*.xml                  linguist-vendored
*.txt                  linguist-vendored
Dockerfile             linguist-vendored
data/**                linguist-vendored

# file ini sendiri bukan kode aplikasi
.gitattributes         linguist-vendored

# ---------- 6. Bahasa yang dikeluarkan dari diagram ----------
# detectable=false = "tidak masuk statistik bahasa", bukan
# klaim bahwa file ini kode pihak ketiga.
*.js       linguist-detectable=false
*.mjs      linguist-detectable=false
*.cjs      linguist-detectable=false
*.css      linguist-detectable=false
*.sh       linguist-detectable=false

# ---------- 7. Layer aplikasi dipaksa dibaca sebagai PHP ----------
# .php  -> entry point CodeIgniter
# .html -> view template yang di-render PHP
# .tsx  -> komponen halaman admin (view) yang disajikan lewat
#          admin-ci/index.php
*.php      linguist-language=PHP
*.html     linguist-language=PHP
*.phtml    linguist-language=PHP
*.inc      linguist-language=PHP
*.tsx      linguist-language=PHP

# .ts dan .scss sengaja TIDAK dipaksa — keduanya tampil sebagai
# TypeScript dan SCSS sesuai bahasa aslinya.

# ---------- 8. PHP selalu terlihat di diagram ----------
*.php      linguist-detectable
